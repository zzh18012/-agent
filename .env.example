# MathModelingOS configuration
# Copy to .env and fill in real values. Never commit .env.

# LLM provider: deepseek | openai | anthropic
MMOS_LLM_PROVIDER=deepseek
MMOS_LLM_MODEL=deepseek-chat
MMOS_LLM_API_KEY=
# Optional override, e.g. https://api.deepseek.com
MMOS_LLM_BASE_URL=
MMOS_LLM_TEMPERATURE=0.2

# Runtime paths (relative to the repository root)
MMOS_PROJECTS_DIR=projects
MMOS_LOGS_DIR=logs

# DEBUG | INFO | WARNING | ERROR
MMOS_LOG_LEVEL=INFO
